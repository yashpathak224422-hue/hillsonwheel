{
  "version": 2,
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/mail-dispatch",
      "destination": "/api/mail-relay"
    },
    {
      "source": "/api/mail-relay",
      "destination": "/api/mail-relay"
    },
    {
      "source": "/api/:match*",
      "destination": "https://hillsonwheels-api.onrender.com/api/:match*"
    },
    {
      "source": "/vendor-admin",
      "destination": "/vendor-admin/index.html"
    },
    {
      "source": "/vendor-admin/(.*)",
      "destination": "/vendor-admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/favicon.(ico|png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
