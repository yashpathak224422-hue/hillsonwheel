# =============================================================================
# HILLSONWHEELS - ENVIRONMENT CONFIGURATION
# =============================================================================
# SECURITY WARNING: Never commit this file with real credentials to version control
# Always use strong, unique secrets in production environments

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Secret - MUST be at least 32 characters, use a cryptographically secure random string
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters-long

# CORS Allowed Origins (comma-separated list of allowed domains)
# Example: https://hillsonwheels.com,https://www.hillsonwheels.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# IP Blacklist (comma-separated list of malicious IPs to block)
BLACKLISTED_IPS=

# Trusted Proxies (comma-separated list of trusted proxy IPs)
TRUSTED_PROXIES=loopback,linklocal,uniquelocal

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MongoDB Connection URI
# Use MongoDB Atlas for production with SSL enabled
MONGODB_URI=mongodb://127.0.0.1:27017/hillsonwheels

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
ORDER_NOTIFICATION_EMAIL=
TOURISM_NOTIFICATION_EMAIL=

# =============================================================================
# WHATSAPP CONFIGURATION (Meta Business API)
# =============================================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_OTP_TEMPLATE=hsw_authentication_code
WHATSAPP_OTP_LANGUAGE=en_US

# =============================================================================
# PAYMENT GATEWAY (Razorpay)
# =============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Note: Never use live keys in development. Use test keys from Razorpay dashboard

# =============================================================================
# PRODUCTION SECURITY CHECKLIST
# =============================================================================
# Before deploying to production:
# [ ] Set NODE_ENV=production
# [ ] Use a strong JWT_SECRET (64+ characters recommended)
# [ ] Configure ALLOWED_ORIGINS with your production domain(s)
# [ ] Set COOKIE_DOMAIN to your production domain
# [ ] Use MongoDB Atlas with SSL and authentication
# [ ] Configure SMTP with real email service
# [ ] Use production Razorpay keys
# [ ] Enable HTTPS/TLS on your server
# [ ] Set up firewall rules
# [ ] Configure backup strategy
# [ ] Enable monitoring and alerting
# [ ] Review and update CORS policy
# [ ] Add any known malicious IPs to BLACKLISTED_IPS